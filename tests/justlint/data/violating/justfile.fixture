mod tools 'tools.just'

# help in a bare comment instead of [doc]
bare-help:
    echo hi

no-help-at-all:
    echo hi

[doc("Never listed, so the help is wasted")]
_hidden:
    echo hi

_no_private_attribute:
    echo hi

[private]
private-without-underscore:
    echo hi

[doc("Forward the user's arguments")]
forward *args:
    uv run app {{ args }}

[doc("Three commands, linewise")]
three-lines:
    echo one
    echo two
    echo three

[doc("A script hidden behind a shebang")]
hidden-script:
    #!/usr/bin/env bash
    set -euo pipefail
    echo one
