#!/usr/bin/env python3
"""Link this repository's path-scoped rule files into Claude Code's user-level
rules directory, so each attaches when a file its `paths:` names is read.

  link-rules [PLUGIN...]            link every scoped rule file, or only
                                    those of the named plugins
  link-rules --unlink [PLUGIN...]   remove this script's links, or only
                                    those of the named plugins
  link-rules -h | --help            print this usage

The rules directory is ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/rules. Each link
is named <plugin>--<topic>.md and points at the rule file in the clone this
script belongs to. A link is this script's own when its target lies under
that clone's plugins/ directory; a run removes only its own links, and never
replaces a file or a link it did not make.

Exit codes: 0 done, 1 done but at least one name was held by something else
and skipped, 2 cannot run (usage, an unknown plugin, the rules directory
cannot be created, a link cannot be written, python3 older than 3.12).

Standard library only, and no syntax newer than Python 3.9 parses, so that an
older python3 reaches the version check below instead of a syntax error.
"""

import enum
import glob
import os
import sys
from typing import NoReturn

PROG = "link-rules"

if sys.version_info < (3, 12):  # noqa: UP036 - the script runs on any python3 on PATH
    sys.stderr.write(f"{PROG}: needs python3 3.12 or later\n")
    sys.exit(2)

USAGE = """\
usage: link-rules [PLUGIN...]
       link-rules --unlink [PLUGIN...]
       link-rules -h | --help

Link every rule file carrying `paths:` frontmatter into
${CLAUDE_CONFIG_DIR:-$HOME/.claude}/rules, one symbolic link per file named
<plugin>--<topic>.md. Plugin names narrow the selection. --unlink removes this
script's own links, all of them or those of the named plugins.
"""


def die(message: str) -> NoReturn:
    sys.stdout.flush()
    sys.stderr.write(f"{PROG}: {message}\n")
    sys.exit(2)


def warn(message: str) -> None:
    sys.stdout.flush()
    sys.stderr.write(f"{PROG}: {message}\n")


def report(verb: str, link: str) -> None:
    print(f"{verb} {os.path.basename(link)}", flush=True)


# Physical, so a clone reached through a symbolic link still yields one stable
# prefix: ownership below is a literal comparison against it. The `..` is
# taken lexically before resolving, as `cd dir/.. && pwd -P` does.
ROOT = os.path.realpath(os.path.abspath(os.path.join(os.path.dirname(__file__), "..")))
PLUGINS_DIR = f"{ROOT}/plugins"


def config_dir() -> str:
    configured = os.environ.get("CLAUDE_CONFIG_DIR", "")
    if configured:
        return configured
    home = os.environ.get("HOME", "")
    if home:
        return f"{home}/.claude"
    die("neither CLAUDE_CONFIG_DIR nor HOME is set")


def is_scoped(path: str) -> bool:
    """Whether a rule file is scoped: its first line is `---` and a line
    starting `paths:` comes before the next `---`.

    Lines are bytes split on `\\n` alone, so a CRLF delimiter is not `---`. The
    frontmatter contract itself is held by the test suite; this does not
    re-validate it.
    """
    try:
        with open(path, "rb") as handle:
            lines = handle.read().split(b"\n")
    except OSError:
        return False
    if lines[0] != b"---":
        return False
    for line in lines[1:]:
        if line == b"---":
            return False
        if line.startswith(b"paths:"):
            return True
    return False


def is_own(link: str) -> bool:
    """Whether a symbolic link is this script's own: its literal target, read
    without resolving, lies under this clone's plugins/ directory. Not
    resolving keeps a dangling link's ownership knowable."""
    try:
        target = os.readlink(link)
    except OSError:
        return False
    return target.startswith(PLUGINS_DIR + "/")


def in_plugins(target: str, plugins: list[str]) -> bool:
    """Whether an own link's target lies under one of the named plugins; with
    no name, every own link matches."""
    if not plugins:
        return True
    return any(target.startswith(f"{PLUGINS_DIR}/{plugin}/") for plugin in plugins)


def same_file(first: str, second: str) -> bool:
    try:
        return os.path.samefile(first, second)
    except OSError:
        return False


def md_links(dest: str) -> list[str]:
    return sorted(glob.glob(f"{glob.escape(dest)}/*.md"))


def remove(link: str) -> None:
    try:
        os.unlink(link)
    except OSError:
        die(f"cannot remove {link}")
    report("unlinked", link)


def prune(dest: str) -> None:
    """Remove every own link whose target is gone or no longer scoped,
    whatever the arguments: only stale links go, so a narrowed run keeps live
    ones."""
    for link in md_links(dest):
        if not os.path.islink(link) or not is_own(link):
            continue
        target = os.readlink(link)
        if os.path.isfile(target) and is_scoped(target):
            continue
        remove(link)


class Outcome(enum.Enum):
    LINKED = enum.auto()
    UNCHANGED = enum.auto()
    # The name is held by a file or link this script did not make.
    SKIPPED = enum.auto()


def link_one(dest: str, file: str) -> Outcome:
    """Link one rule file under its name, leaving alone whatever this script
    does not own."""
    rel = file[len(PLUGINS_DIR) + 1 :]
    plugin = rel.split("/", 1)[0]
    topic = os.path.basename(file).removesuffix(".md")
    name = f"{plugin}--{topic}.md"
    link = f"{dest}/{name}"

    if os.path.islink(link):
        if is_own(link):
            if same_file(link, file):
                return Outcome.UNCHANGED
        elif same_file(link, file):
            return Outcome.UNCHANGED
        else:
            warn(f"{name}: held by a link to {os.readlink(link)} this script did not make; skipped")
            return Outcome.SKIPPED
    elif os.path.lexists(link):
        warn(f"{name}: held by a file this script did not make; skipped")
        return Outcome.SKIPPED

    try:
        if os.path.islink(link):
            os.unlink(link)
        os.symlink(file, link)
    except OSError:
        die(f"cannot link {name}")
    print(f"linked {name}", flush=True)
    return Outcome.LINKED


def link_files(dest: str, plugins: list[str]) -> bool:
    """Link every scoped candidate, of every plugin or of the named ones.
    Returns whether any name was skipped."""
    escaped = glob.escape(PLUGINS_DIR)
    if plugins:
        patterns = [
            f"{escaped}/{glob.escape(plugin)}/skills/*/references/*.md" for plugin in plugins
        ]
    else:
        patterns = [f"{escaped}/*/skills/*/references/*.md"]
    skipped = False
    for pattern in patterns:
        for file in sorted(glob.glob(pattern)):
            if os.path.isfile(file) and is_scoped(file) and link_one(dest, file) is Outcome.SKIPPED:
                skipped = True
    return skipped


def unlink_all(dest: str, plugins: list[str]) -> None:
    if not os.path.isdir(dest):
        return
    for link in md_links(dest):
        if not os.path.islink(link) or not is_own(link):
            continue
        if in_plugins(os.readlink(link), plugins):
            remove(link)


def main(argv: list[str]) -> int:
    dest = f"{config_dir()}/rules"

    mode = "link"
    if argv and argv[0] in ("-h", "--help"):
        if len(argv) != 1:
            die(f"'{argv[0]}' takes no argument")
        sys.stdout.write(USAGE)
        return 0
    if argv and argv[0] == "--unlink":
        mode = "unlink"
        argv = argv[1:]

    # Every argument is checked before anything is touched.
    for arg in argv:
        if arg.startswith("-"):
            die(f"unknown option '{arg}'")
        if arg in ("", ".", "..") or "/" in arg:
            die(f"no plugin named '{arg}'")
        if not os.path.isdir(f"{PLUGINS_DIR}/{arg}"):
            die(f"no plugin named '{arg}'")

    if mode == "unlink":
        unlink_all(dest, argv)
        return 0

    try:
        os.makedirs(dest, exist_ok=True)
    except OSError:
        die(f"cannot create the rules directory {dest}")
    if not os.path.isdir(dest):
        die(f"the rules directory {dest} is not a directory")
    prune(dest)
    return 1 if link_files(dest, argv) else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
