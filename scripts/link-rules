#!/usr/bin/env bash
# Link this repository's path-scoped rule files into Claude Code's user-level
# rules directory, so each attaches when a file its `paths:` names is read.
#
#   link-rules [PLUGIN...]            link every scoped rule file, or only
#                                     those of the named plugins
#   link-rules --unlink [PLUGIN...]   remove this script's links, or only
#                                     those of the named plugins
#   link-rules -h | --help            print this usage
#
# The rules directory is ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/rules. Each link
# is named <plugin>--<topic>.md and points at the rule file in the clone this
# script belongs to. A link is this script's own when its target lies under
# that clone's plugins/ directory; a run removes only its own links, and never
# replaces a file or a link it did not make.
#
# Exit codes: 0 done, 1 done but at least one name was held by something else
# and skipped, 2 cannot run (usage, an unknown plugin, the rules directory
# cannot be created, a link cannot be written).
set -euo pipefail

usage() {
	cat <<'EOF'
usage: link-rules [PLUGIN...]
       link-rules --unlink [PLUGIN...]
       link-rules -h | --help

Link every rule file carrying `paths:` frontmatter into
${CLAUDE_CONFIG_DIR:-$HOME/.claude}/rules, one symbolic link per file named
<plugin>--<topic>.md. Plugin names narrow the selection. --unlink removes this
script's own links, all of them or those of the named plugins.
EOF
}

die() {
	printf 'link-rules: %s\n' "$1" >&2
	exit 2
}

warn() {
	printf 'link-rules: %s\n' "$1" >&2
}

# Physical, so a clone reached through a symbolic link still yields one stable
# prefix: ownership below is a literal comparison against it.
root=$(cd "$(dirname "$0")/.." && pwd -P)
readonly root
readonly plugins_dir="${root}/plugins"

if [[ -n ${CLAUDE_CONFIG_DIR:-} ]]; then
	config_dir=$CLAUDE_CONFIG_DIR
elif [[ -n ${HOME:-} ]]; then
	config_dir="${HOME}/.claude"
else
	die 'neither CLAUDE_CONFIG_DIR nor HOME is set'
fi
readonly dest="${config_dir}/rules"

mode='link'
case ${1:-} in
-h | --help)
	(($# == 1)) || die "'$1' takes no argument"
	usage
	exit 0
	;;
--unlink)
	mode='unlink'
	shift
	;;
esac

# Every argument is checked before anything is touched.
for arg; do
	case $arg in
	-*) die "unknown option '${arg}'" ;;
	'' | . | .. | */*) die "no plugin named '${arg}'" ;;
	esac
	[[ -d ${plugins_dir}/${arg} ]] || die "no plugin named '${arg}'"
done

# Whether a rule file is scoped: its first line is `---` and a line starting
# `paths:` comes before the next `---`. The frontmatter contract itself is
# held by the test suite; this does not re-validate it.
is_scoped() {
	awk 'NR == 1 && $0 != "---" { exit }
	     NR > 1 && $0 == "---" { exit }
	     NR > 1 && /^paths:/ { found = 1; exit }
	     END { exit found ? 0 : 1 }' "$1"
}

# Whether a symbolic link is this script's own: its literal target, read
# without resolving, lies under this clone's plugins/ directory. Not resolving
# keeps a dangling link's ownership knowable.
is_own() {
	local target
	target=$(readlink "$1") || return 1
	case $target in
	"${plugins_dir}"/*) return 0 ;;
	*) return 1 ;;
	esac
}

# Whether an own link's target lies under one of the named plugins; with no
# name, every own link matches.
in_plugins() {
	local target=$1 plugin
	shift
	(($# > 0)) || return 0
	for plugin; do
		case $target in
		"${plugins_dir}/${plugin}"/*) return 0 ;;
		esac
	done
	return 1
}

status=0

# Remove every own link whose target is gone or no longer scoped, whatever the
# arguments: only stale links go, so a narrowed run keeps live ones.
prune() {
	local link target
	for link in "$dest"/*.md; do
		[[ -L $link ]] || continue
		is_own "$link" || continue
		target=$(readlink "$link")
		if [[ -f $target ]] && is_scoped "$target"; then
			continue
		fi
		rm -- "$link" || die "cannot remove ${link}"
		printf 'unlinked %s\n' "${link##*/}"
	done
}

# Link one rule file under its name, leaving alone whatever this script does
# not own.
link_one() {
	local file=$1 rel plugin topic name link target
	rel=${file#"${plugins_dir}/"}
	plugin=${rel%%/*}
	topic=${file##*/}
	topic=${topic%.md}
	name="${plugin}--${topic}.md"
	link="${dest}/${name}"

	if [[ -L $link ]]; then
		if is_own "$link"; then
			[[ $link -ef $file ]] && return 0
		elif [[ $link -ef $file ]]; then
			return 0
		else
			target=$(readlink "$link")
			warn "${name}: held by a link to ${target} this script did not make; skipped"
			status=1
			return 0
		fi
	elif [[ -e $link ]]; then
		warn "${name}: held by a file this script did not make; skipped"
		status=1
		return 0
	fi

	ln -sfn "$file" "$link" || die "cannot link ${name}"
	printf 'linked %s\n' "$name"
}

# Link a candidate rule file when it is a scoped one. An unmatched glob comes
# through as its literal pattern, which is not a regular file.
link_candidate() {
	[[ -f $1 ]] || return 0
	is_scoped "$1" || return 0
	link_one "$1"
}

link_files() {
	local file plugin
	if (($# == 0)); then
		for file in "${plugins_dir}"/*/skills/*/references/*.md; do
			link_candidate "$file"
		done
		return 0
	fi
	for plugin; do
		for file in "${plugins_dir}/${plugin}"/skills/*/references/*.md; do
			link_candidate "$file"
		done
	done
}

unlink_all() {
	local link target
	[[ -d $dest ]] || return 0
	for link in "$dest"/*.md; do
		[[ -L $link ]] || continue
		is_own "$link" || continue
		target=$(readlink "$link")
		in_plugins "$target" ${1+"$@"} || continue
		rm -- "$link" || die "cannot remove ${link}"
		printf 'unlinked %s\n' "${link##*/}"
	done
}

case $mode in
link)
	mkdir -p -- "$dest" 2>/dev/null || die "cannot create the rules directory ${dest}"
	[[ -d $dest ]] || die "the rules directory ${dest} is not a directory"
	prune
	link_files ${1+"$@"}
	;;
unlink)
	unlink_all ${1+"$@"}
	;;
esac

exit "$status"
